# Security
SECRET_KEY=change-this-to-a-long-random-string-in-production
ENCRYPTION_KEY=change-this-to-a-different-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (SQLite for local, can use PostgreSQL on Render)
DATABASE_URL=sqlite+aiosqlite:///./hireflow.db

# Groq AI (free at console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

GROQ_MODEL=llama-3.3-70b-versatile

# CORS — comma-separated list of allowed origins
# ALLOWED_ORIGINS=["http://localhost:5173","https://your-app.vercel.app"]

# System SMTP — used for password-reset OTP emails
# Gmail: use an App Password (Google Account → Security → App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=TLS
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_FROM_NAME=HireFlow AI
SMTP_FROM_EMAIL=your_gmail@gmail.com
